# Google Analytics 4 service account JSON (server-only). Used by /api/ga4/report
# and /api/ga4/service-account. Generate a service account key in Google Cloud
# Console, then paste the entire JSON file contents as a single-line string.
GA4_SA_KEY={"type":"service_account","client_email":"...","private_key":"..."}

# Anthropic API key (server-only). Used by /api/suggest-initiatives.
ANTHROPIC_API_KEY=

# Supabase Auth (public — safe to expose to the browser). Find these in your
# Supabase project: Settings > API. Used for email/password and Google sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public). Shows a CAPTCHA on the email sign-up
# and sign-in forms; the token is passed to Supabase as captchaToken. Pair it
# with the secret key in Supabase: Authentication > Attack Protection > CAPTCHA
# (provider Turnstile). Leave blank locally to skip the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Canonical site URL, used for SEO canonical links, sitemap, and structured
# data. On Vercel this is derived automatically from the deployment; set it
# explicitly once you point a custom domain at the app, e.g. https://utmbuilder.com
NEXT_PUBLIC_SITE_URL=

# Conversion tracking (public). Each is optional — leave blank and nothing
# loads. See src/lib/analytics.ts.
#   Google Tag Manager container ID, e.g. GTM-XXXXXXX. GA4 and Google Ads are
#   configured inside the GTM container (import the provided container JSON);
#   the app pushes account_created / first_utm_saved / builder_used_no_signup /
#   bulk_builder_used events to the dataLayer for GTM to pick up.
NEXT_PUBLIC_GTM_ID=
#   Meta (Facebook/Instagram) Pixel ID, e.g. 123456789012345 (optional)
NEXT_PUBLIC_META_PIXEL_ID=
